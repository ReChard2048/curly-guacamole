      "q": "线性筛（欧拉筛）的时间复杂度是？",
      "options": [
        "O(n log n)",
        "O(n)",
        "O(n√n)",
        "O(n²)"
      ],
      "answer": 1,
      "explain": "每个合数只被其最小质因子筛一次。"
    },
    {
      "id": "v02",
      "type": "judge",
      "q": "埃氏筛的时间复杂度是 O(n log log n)。",
      "answer": true,
      "explain": "每个质数筛掉其倍数，总复杂度约 n log log n。"
    },
    {
      "id": "v03",
      "type": "single",
      "q": "线性筛中，每个合数被谁筛掉？",
      "options": [
        "它的最大质因子",
        "它的最小质因子",
        "任意质因子",
        "它的平方根"
      ],
      "answer": 1,
      "explain": "保证每个合数只被最小质因子筛一次。"
    },
    {
      "id": "v04",
      "type": "single",
      "q": "积性函数 f 满足什么条件？",
      "options": [
        "f(ab) = f(a) + f(b)",
        "gcd(a,b)=1 时 f(ab) = f(a)f(b)",
        "f(a) = a",
        "f 是常数"
      ],
      "answer": 1,
      "explain": "互质时乘积的函数值等于函数值乘积。"
    },
    {
      "id": "v05",
      "type": "judge",
      "q": "欧拉函数 φ(n) 是积性函数。",
      "answer": true,
      "explain": "互质时 φ(ab)=φ(a)φ(b)。"
    },
    {
      "id": "v06",
      "type": "single",
      "q": "线性筛中，当 `i % prime[j] == 0` 时应？",
      "options": [
        "继续循环",
        "break",
        "跳过",
        "重置"
      ],
      "answer": 1,
      "explain": "保证每个合数只被最小质因子筛一次。"
    },
    {
      "id": "v07",
      "type": "single",
      "q": "欧拉函数 φ(n) 表示？",
      "options": [
        "n 的约数个数",
        "1 到 n 中与 n 互质的数的个数",
        "n 的质因子个数",
        "n 的位数"
      ],
      "answer": 1,
      "explain": "φ(n) 是小于等于 n 且与 n 互质的正整数个数。"
    },
    {
      "id": "v08",
      "type": "judge",
      "q": "线性筛可以同时求欧拉函数。",
      "answer": true,
      "explain": "利用积性和最小质因子递推。"
    },
    {
      "id": "v09",
      "type": "single",
      "q": "若 n = p^k（p 为质数），φ(n) = ？",
      "options": [
        "p^k",
        "p^k - p^(k-1)",
        "p - 1",
        "k"
      ],
      "answer": 1,
      "explain": "φ(p^k) = p^k - p^(k-1)。"
    },
    {
      "id": "v10",
      "type": "single",
      "q": "埃氏筛中，筛到质数 p 时从哪个数开始筛？",
      "options": [
        "2p",
        "p",
        "p²",
        "p+1"
      ],
      "answer": 2,
      "explain": "小于 p² 的合数已被更小质数筛过，从 p² 开始。"
    }
  ],
